  <!-- القسم الافتتاحي Hero مع نموذج الحجز المباشر بالواجهة -->
  <section id="booking" class="hero">
    <div class="container">
      <div class="hero-grid">
        
        <div>
          <div class="hero-tag">✨ ابتسامة أجمل.. وعناية متكاملة تدوم</div>
          <h2 class="hero-title">عناية طبية متقدمة بأقرب فرع منك في <span>الأحساء</span></h2>
