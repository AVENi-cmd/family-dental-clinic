    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- منطق الفروع والحجز -->
  <script>
    const branchData = [
      { name: "فرع السلمانية", phone: "0553254700", intl: "966553254700", time: "من 9 صباحاً - 9 مساءً", map: "https://maps.google.com/?q=25.3340626,49.5662766" },
      { name: "فرع محاسن", phone: "0537403090", intl: "966537403090", time: "من 8 صباحاً - 10 مساءً", map: "https://maps.google.com/?q=25.4057865,49.5613327" },
      { name: "فرع الخالدية", phone: "0550932600", intl: "966550932600", time: "من 9 صباحاً - 9 مساءً", map: "https://maps.app.goo.gl/rMkWJcZ8n8B9UaX47" },
      { name: "فرع المزروع", phone: "0534634447", intl: "966534634447", time: "من 1 مساءً - 9 مساءً", map: "https://maps.app.goo.gl/atdF1Dh3jvJYZdm4A" },
      { name: "فرع الشقيق", phone: "0556854440", intl: "966556854440", time: "من 9 صباحاً - 9 مساءً", map: "https://maps.app.goo.gl/GSjZfgh7WZGarKZ67" },
      { name: "فرع الجفر", phone: "0550892700", intl: "966550892700", time: "من 9 صباحاً - 9 مساءً", map: "https://maps.app.goo.gl/ArGiApru7Uv6yhTo7" },
      { name: "فرع العيون 1", phone: "0553962300", intl: "966553962300", time: "من 1 مساءً - 9 مساءً", map: "https://maps.google.com/?q=25.6022835,49.5630684" },
      { name: "فرع العيون الصناعية", phone: "0536902220", intl: "966536902220", time: "من 9 صباحاً - 9 مساءً", map: "https://maps.google.com/?q=25.6033344,49.5639687" }
    ];

    function selectBranch(idx) {
      const b = branchData[idx];
      document.querySelectorAll('.branch-pill').forEach((pill, i) => {
        pill.classList.toggle('active', i === idx);
      });

      document.getElementById('branchInfo').innerHTML = `
        <h3 style="font-size: 20px; font-weight: 800; color: #0f172a;">${b.name}</h3>
        <p style="color: #64748b; font-size: 14px; margin: 6px 0;"><i class="fa-regular fa-clock" style="color: var(--brand-teal);"></i> مواعيد العمل: ${b.time}</p>
        <p style="color: #64748b; font-size: 14px;"><i class="fa-solid fa-phone" style="color: var(--brand-lime-dark);"></i> الرقم: ${b.phone}</p>
        <div class="card-actions">
          <a href="tel:${b.phone}" class="action-btn btn-call"><i class="fa-solid fa-phone"></i> اتصال مباشر</a>
          <a href="https://wa.me/${b.intl}?text=${encodeURIComponent('مرحباً ' + b.name + '، أرغب بحجز موعد استشارة لديكم')}" target="_blank" class="action-btn btn-wa"><i class="fa-brands fa-whatsapp"></i> واتساب الفرع</a>
          <a href="${b.map}" target="_blank" class="action-btn btn-map"><i class="fa-solid fa-location-dot" style="color: #ef4444;"></i> فتح بالخريطة</a>
        </div>
      `;
    }

    function handleHeroBooking(e) {
      e.preventDefault();
      const name = document.getElementById('clientName').value.trim();
      const phone = document.getElementById('clientPhone').value.trim();
      const bName = document.getElementById('clientBranch').value;
      
      const target = branchData.find(b => b.name.includes(bName)) || branchData[0];
      const msg = `مرحباً مجمع الأسرة (${target.name})،\nأرغب بحجز موعد استشارة جديدة:\n- الاسم: ${name}\n- رقم الجوال: ${phone}\n- الفرع المطلوب: ${target.name}`;
      window.open(`https://wa.me/${target.intl}?text=${encodeURIComponent(msg)}`, '_blank');
    }

    window.onload = () => selectBranch(0);
  </script>

