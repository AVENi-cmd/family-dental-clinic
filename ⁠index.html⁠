              <span>تأكيد الحجز عبر الواتساب</span>
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- قسم الفروع التفاعلي (8 فروع) -->
  <section class="container" style="padding: 40px 16px;">
